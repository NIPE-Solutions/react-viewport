{
  "name": "@nipe-solutions/react-viewport",
  "version": "0.1.0-alpha.0",
  "description": "Reactive React viewport geometry for layout, visual viewport, keyboards, and safe areas.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NIPE-Solutions/react-viewport.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11",
  "scripts": {
    "build": "npm run build:website",
    "build:dist": "vite build && tsc -p tsconfig.build.json",
    "build:website": "npm run build:dist && next build website",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build:dist && npm run test:api && npm run test:size && npm run test:package && node scripts/verify-docs.mjs && npm run build && node scripts/verify-website.mjs && npm run test:workflows",
    "dev:website": "npm run build:dist && next dev website",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "release:check": "node scripts/verify-release.mjs",
    "serve:website": "node scripts/serve-website.mjs",
    "test": "npm run test:unit && npm run test:types",
    "test:api": "node scripts/check-public-api.mjs",
    "test:e2e": "playwright test",
    "test:website:e2e": "playwright test --config playwright.website.config.ts",
    "test:package": "node --test test/package/*.test.mjs",
    "test:size": "node scripts/check-bundle-size.mjs",
    "test:types": "tsc --project test/types/tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:workflows": "node --test scripts/verify-workflows.test.mjs scripts/verify-release.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "next": "^16.3.4",
    "prettier": "^3.9.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
